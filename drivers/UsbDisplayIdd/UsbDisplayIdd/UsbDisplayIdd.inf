;
; UsbDisplayIdd.inf
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System ; TODO: specify appropriate Class
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318} ; TODO: specify appropriate ClassGuid
Provider    = %ManufacturerName%
CatalogFile = UsbDisplayIdd.cat
DriverVer   = ; TODO: set DriverVer in stampinf property pages
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
UsbDisplayIdd.sys = 1,,

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName% = Standard,NT$ARCH$.10.0...16299 ; %13% support introduced in build 16299

[Standard.NT$ARCH$.10.0...16299]
%UsbDisplayIdd.DeviceDesc% = UsbDisplayIdd_Device, Root\UsbDisplayIdd ; TODO: edit hw-id

[UsbDisplayIdd_Device.NT]
CopyFiles = File_Copy

[File_Copy]
UsbDisplayIdd.sys

;-------------- Service installation
[UsbDisplayIdd_Device.NT.Services]
AddService = UsbDisplayIdd,%SPSVCINST_ASSOCSERVICE%, UsbDisplayIdd_Service_Inst

; -------------- UsbDisplayIdd driver install sections
[UsbDisplayIdd_Service_Inst]
DisplayName    = %UsbDisplayIdd.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\UsbDisplayIdd.sys

[UsbDisplayIdd_Device.NT.Wdf]
KmdfService = UsbDisplayIdd, UsbDisplayIdd_wdfsect

[UsbDisplayIdd_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ManufacturerName = "<Your manufacturer name>" ;TODO: Replace with your manufacturer name
DiskName = "UsbDisplayIdd Installation Disk"
UsbDisplayIdd.DeviceDesc = "UsbDisplayIdd Device"
UsbDisplayIdd.SVCDESC = "UsbDisplayIdd Service"
