# Панель как экран подтверждений Claude Code (и часы, когда карточек нет).
# install: cp systemd/ccdispd.service ~/.config/systemd/user/
#          systemctl --user enable --now ccdispd
[Unit]
Description=ccdispd — RoboPeak USB panel for Claude Code
After=graphical-session.target
# одна панель — один владелец
Conflicts=ccdisp-clock.service

[Service]
Type=simple
WorkingDirectory=%h/GitHub/rpusbdisp/smartscreen
ExecStart=/usr/bin/python3 -m ccdisp.daemon
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
