# Панель как самостоятельные часы с погодой, без хуков Claude Code.
# install: cp systemd/ccdisp-clock.service ~/.config/systemd/user/
#          systemctl --user enable --now ccdisp-clock
[Unit]
Description=ccdisp.clock — RoboPeak USB panel as a clock
After=graphical-session.target
# одна панель — один владелец
Conflicts=ccdispd.service

[Service]
Type=simple
WorkingDirectory=%h/GitHub/rpusbdisp/smartscreen
ExecStart=/usr/bin/python3 -m ccdisp.clock
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
